# Paste your Neon PostgreSQL connection string here for local development.
# Keep the real value private and never commit a populated .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
MAX_PEOPLE=5

# Optional: add a TURN relay for networks where STUN-only P2P cannot connect.
# TURN_URL=turn:your-turn-host:3478
# TURN_USER=your-turn-username
# TURN_PASS=your-turn-password
